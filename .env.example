# Modelo do arquivo .env. Copie para .env e cole as chaves lá (o .env nunca vai para o Git).

# football-data.org: cadastro grátis em https://www.football-data.org/client/register
# A chave chega por e-mail ("API Token").
FOOTBALL_DATA_API_KEY=

# API-Football (api-sports.io): cadastro grátis em https://dashboard.api-football.com/register
# A chave fica no painel, em "Account > My Access".
API_FOOTBALL_KEY=
